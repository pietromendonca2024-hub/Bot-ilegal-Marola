function readStore() {
  try {
    return JSON.parse(fs.readFileSync(DATA_FILE, 'utf8'));
  } catch {
    return { guilds: {} };
  }
}

const store = readStore();

function saveStore() {
  fs.mkdirSync(DATA_DIRECTORY, { recursive: true });
  fs.writeFileSync(DATA_FILE, JSON.stringify(store, null, 2));
}

function getGuildState(guildId) {
  store.guilds ??= {};
  store.guilds[guildId] ??= {
    roles: {},
    channels: {},
    ticketNumber: 0,
    displayName: null,
  };
  return store.guilds[guildId];
}

function baseEmbed(title, description) {
  return new EmbedBuilder()
    .setColor(BRAND_COLOR)
    .setTitle(title)
    .setDescription(description)
    .setFooter({ text: MANAGED_BY })
    .setTimestamp();
}

function cleanChannelPart(value) {
  const normalized = value
    .toLowerCase()
    .normalize('NFD')
    .replace(/[\u0300-\u036f]/g, '')
    .replace(/[^a-z0-9-]/g, '-')
    .replace(/-+/g, '-')
    .replace(/^-|-$/g, '');

  return normalized.slice(0, 24) || 'membro';
}

async function getMember(interaction) {
  return interaction.guild.members.fetch(interaction.user.id);
}

async function canManage(interaction) {
  if (!interaction.inGuild()) return false;
  if (interaction.guild.ownerId === interaction.user.id) return true;
  const member = await getMember(interaction);
  return member.permissions.has(PermissionFlagsBits.ManageGuild);
}

async function isTeamMember(interaction) {
  if (!interaction.inGuild()) return false;
  if (await canManage(interaction)) return true;

  const member = await getMember(interaction);
  return member.roles.cache.some((role) =>
    ['🛡️ | Gerência', '⚖️ | Staff', '🎫 | Suporte'].includes(role.name),
  );
}

function botPermissionsMissing(guild) {
  const me = guild.members.me;
  if (!me) return ['não foi possível localizar o bot no servidor'];

  const required = [
    [PermissionFlagsBits.ManageRoles, 'Gerenciar cargos'],
    [PermissionFlagsBits.ManageChannels, 'Gerenciar canais'],
    [PermissionFlagsBits.ViewChannel, 'Ver canais'],
    [PermissionFlagsBits.SendMessages, 'Enviar mensagens'],
    [PermissionFlagsBits.EmbedLinks, 'Incorporar links'],
  ];

  return required
    .filter(([permission]) => !me.permissions.has(permission))
    .map(([, label]) => label);
}

async function getTrackedRole(guild, state, key) {
  const id = state.roles[key];
  if (!id) return null;
  return guild.roles.fetch(id).catch(() => null);
}

async function ensureRole(guild, state, definition, syncPermissions) {
  let role = await getTrackedRole(guild, state, definition.key);
  const wasTracked = Boolean(role);

  if (!role) {
    role = guild.roles.cache.find((candidate) => candidate.name === definition.name) ?? null;
  }

  if (!role) {
    role = await guild.roles.create({
      name: definition.name,
      color: definition.color,
      permissions: definition.permissions,
      mentionable: false,
      reason: `${MANAGED_BY}: criação de cargo`,
    });
  } else if (wasTracked && syncPermissions && role.editable) {
    await role.edit({
      color: definition.color,
      permissions: definition.permissions,
      mentionable: false,
      reason: `${MANAGED_BY}: sincronização de permissões`,
    });
  }

  state.roles[definition.key] = role.id;
  return role;
}

async function getTrackedChannel(guild, state, key, type) {
  const id = state.channels[key];
  if (!id) return null;
  const channel = await guild.channels.fetch(id).catch(() => null);
  return channel?.type === type ? channel : null;
}

async function ensureChannel(guild, state, config, syncPermissions) {
  let channel = await getTrackedChannel(guild, state, config.key, config.type);
  const wasTracked = Boolean(channel);

  if (!channel) {
    channel = guild.channels.cache.find(
      (candidate) =>
        candidate.type === config.type &&
        candidate.name === config.name &&
        (config.parentId ? candidate.parentId === config.parentId : !candidate.parentId),
    );
  }

  if (!channel) {
    channel = await guild.channels.create({
      name: config.name,
      type: config.type,
      parent: config.parentId,
      permissionOverwrites: config.permissionOverwrites,
      reason: `${MANAGED_BY}: criação de estrutura`,
    });
  } else if (wasTracked) {
    const changes = {};
    if (channel.name !== config.name) changes.name = config.name;
    if (config.parentId && channel.parentId !== config.parentId) changes.parent = config.parentId;
    if (Object.keys(changes).length) {
      await channel.edit({ ...changes, reason: `${MANAGED_BY}: atualização de estrutura` });
    }
    if (syncPermissions && config.permissionOverwrites) {
      await channel.permissionOverwrites.set(config.permissionOverwrites, `${MANAGED_BY}: sincronização de permissões`);
    }
  }

  state.channels[config.key] = channel.id;
  return channel;
}

function teamOverwrites(guild, roles) {
  return [
    { id: guild.roles.everyone.id, deny: [PermissionFlagsBits.ViewChannel] },
    {
      id: client.user.id,
      allow: [
        PermissionFlagsBits.ViewChannel,
        PermissionFlagsBits.SendMessages,
        PermissionFlagsBits.ReadMessageHistory,
        PermissionFlagsBits.EmbedLinks,
        PermissionFlagsBits.ManageChannels,
        PermissionFlagsBits.ManageMessages,
      ],
    },
    {
      id: roles.management.id,
      allow: [
        PermissionFlagsBits.ViewChannel,
        PermissionFlagsBits.SendMessages,
        PermissionFlagsBits.ReadMessageHistory,
      ],
    },
    {
      id: roles.staff.id,
      allow: [
        PermissionFlagsBits.ViewChannel,
        PermissionFlagsBits.SendMessages,
        PermissionFlagsBits.ReadMessageHistory,
      ],
    },
    {
      id: roles.support.id,
      allow: [
        PermissionFlagsBits.ViewChannel,
        PermissionFlagsBits.SendMessages,
        PermissionFlagsBits.ReadMessageHistory,
      ],
    },
  ];
}

function readonlyOverwrites(guild, roles) {
  return [
    {
      id: guild.roles.everyone.id,
      deny: [
        PermissionFlagsBits.SendMessages,
        PermissionFlagsBits.AddReactions,
        PermissionFlagsBits.CreatePublicThreads,
        PermissionFlagsBits.CreatePrivateThreads,
      ],
    },
    {
      id: roles.management.id,
      allow: [
        PermissionFlagsBits.SendMessages,
        PermissionFlagsBits.EmbedLinks,
        PermissionFlagsBits.AttachFiles,
      ],
    },
    {
      id: roles.staff.id,
      allow: [PermissionFlagsBits.SendMessages, PermissionFlagsBits.EmbedLinks],
    },
    {
      id: client.user.id,
      allow: [
        PermissionFlagsBits.ViewChannel,
        PermissionFlagsBits.SendMessages,
        PermissionFlagsBits.ReadMessageHistory,
        PermissionFlagsBits.EmbedLinks,
        PermissionFlagsBits.AttachFiles,
      ],
    },
  ];
}

function territoryOverwrites(guild, roles, territory) {
  const territoryRoleKeys = [
    `territory_${territory.key}`,
    `leader_${territory.key}`,
    `front_${territory.key}`,
    `manager_${territory.key}`,
  ];

  return [
    ...teamOverwrites(guild, roles),
    ...territoryRoleKeys.map((key) => ({
      id: roles[key].id,
      allow: [
        PermissionFlagsBits.ViewChannel,
        PermissionFlagsBits.SendMessages,
        PermissionFlagsBits.ReadMessageHistory,
        PermissionFlagsBits.EmbedLinks,
        PermissionFlagsBits.AttachFiles,
      ],
    })),
  ];
}

