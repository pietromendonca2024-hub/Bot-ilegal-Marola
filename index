async function getManagedTextChannel(guild, state, key) {
  const id = state.channels[key];
  if (!id) return null;
  const channel = await guild.channels.fetch(id).catch(() => null);
  return channel?.type === ChannelType.GuildText ? channel : null;
}

function ticketOwnerId(channel) {
  return channel?.topic?.match(/owner:(\d{17,20})/)?.[1] ?? null;
}

async function createPrivateTicket(interaction, options) {
  const guild = interaction.guild;
  const state = getGuildState(guild.id);
  const missing = botPermissionsMissing(guild);
  if (missing.length) {
    throw new Error(`O bot não possui: ${missing.join(', ')}.`);
  }

  await guild.channels.fetch();

  const ticketsCategory = await guild.channels.fetch(state.channels.category_tickets).catch(() => null);
  if (!ticketsCategory || ticketsCategory.type !== ChannelType.GuildCategory) {
    throw new Error('A categoria de tickets não existe. Execute `/setup` primeiro.');
  }

  const existing = guild.channels.cache.find(
    (channel) => channel.type === ChannelType.GuildText && ticketOwnerId(channel) === interaction.user.id,
  );
  if (existing) {
    throw new Error(`Você já possui um atendimento aberto: ${existing}.`);
  }

  await guild.roles.fetch();
  const management = await getTrackedRole(guild, state, 'management');
  const staff = await getTrackedRole(guild, state, 'staff');
  const support = await getTrackedRole(guild, state, 'support');
  if (!management || !staff || !support) {
    throw new Error('Os cargos da equipe não foram encontrados. Execute `/setup` novamente.');
  }

  state.ticketNumber = Number(state.ticketNumber || 0) + 1;
  saveStore();

  const number = String(state.ticketNumber).padStart(4, '0');
  const username = cleanChannelPart(interaction.user.username);
  const channel = await guild.channels.create({
    name: `${options.kind === 'Solicitação' ? 'solicitacao' : 'ticket'}-${number}-${username}`,
    type: ChannelType.GuildText,
    parent: ticketsCategory.id,
    topic: `owner:${interaction.user.id} | type:${options.kind}`,
    permissionOverwrites: [
      { id: guild.roles.everyone.id, deny: [PermissionFlagsBits.ViewChannel] },
      {
        id: interaction.user.id,
        allow: [
          PermissionFlagsBits.ViewChannel,
          PermissionFlagsBits.SendMessages,
          PermissionFlagsBits.ReadMessageHistory,
          PermissionFlagsBits.EmbedLinks,
          PermissionFlagsBits.AttachFiles,
        ],
      },
      ...[management, staff, support].map((role) => ({
        id: role.id,
        allow: [
          PermissionFlagsBits.ViewChannel,
          PermissionFlagsBits.SendMessages,
          PermissionFlagsBits.ReadMessageHistory,
          PermissionFlagsBits.ManageMessages,
        ],
      })),
      {
        id: client.user.id,
        allow: [
          PermissionFlagsBits.ViewChannel,
          PermissionFlagsBits.SendMessages,
          PermissionFlagsBits.ReadMessageHistory,
          PermissionFlagsBits.ManageChannels,
          PermissionFlagsBits.ManageMessages,
        ],
      },
    ],
    reason: `${MANAGED_BY}: ${options.kind.toLowerCase()} de ${interaction.user.tag}`,
  });

  const details = options.details
    ? `\n\n**Dados enviados**\n${options.details}`
    : '\n\nExplique abaixo como a equipe pode ajudar.';
  const controls = new ActionRowBuilder().addComponents(
    new ButtonBuilder()
      .setCustomId('ticket:claim')
      .setLabel('Assumir')
      .setEmoji('🙋')
      .setStyle(ButtonStyle.Primary),
    new ButtonBuilder()
      .setCustomId('ticket:close')
      .setLabel('Fechar')
      .setEmoji('🔒')
      .setStyle(ButtonStyle.Danger),
  );

  await channel.send({
    content: `${interaction.user} <@&${support.id}>`,
    embeds: [
      baseEmbed(`${options.kind} #${number}`, `Olá, ${interaction.user}. A equipe foi avisada.${details}`),
    ],
    components: [controls],
  });

  return channel;
}

