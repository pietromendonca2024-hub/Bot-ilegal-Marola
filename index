async function replyError(interaction, message) {
  const payload = { content: `❌ ${message}`, ephemeral: true };
  if (interaction.deferred) return interaction.editReply(payload);
  if (interaction.replied) return interaction.followUp(payload);
  return interaction.reply(payload);
}

async function handleSetup(interaction) {
  if (!(await canManage(interaction))) {
    return replyError(interaction, 'Você precisa da permissão **Gerenciar servidor** para usar este comando.');
  }

  const missing = botPermissionsMissing(interaction.guild);
  if (missing.length) {
    return replyError(interaction, `Conceda ao bot as permissões: **${missing.join(', ')}** e tente novamente.`);
  }

  await interaction.deferReply({ ephemeral: true });
  const displayName = interaction.options.getString('nome')?.trim();
  const syncPermissions = interaction.options.getBoolean('sincronizar_permissoes') ?? false;
  const result = await setupGuild(interaction.guild, displayName, syncPermissions);

  await interaction.editReply({
    embeds: [
      baseEmbed(
        '✅ Estrutura pronta',
        [
          `Foram preparados **${ROLE_DEFINITIONS.length + TERRITORY_ROLE_DEFINITIONS.length} cargos**, categorias, canais de texto e salas de voz para **${result.state.displayName}**.`,
          'Use `/gerenciar painel:Tickets` e `/gerenciar painel:Solicitações` para publicar os painéis.',
          syncPermissions
            ? 'As permissões dos recursos já registrados pelo bot também foram sincronizadas.'
            : 'Canais e cargos já existentes fora do controle do bot não foram modificados.',
        ].join('\n\n'),
      ),
    ],
  });
}

async function handleManage(interaction) {
  if (!(await canManage(interaction))) {
    return replyError(interaction, 'Você precisa da permissão **Gerenciar servidor** para usar este comando.');
  }

  const state = getGuildState(interaction.guild.id);
  const panel = interaction.options.getString('painel', true);
  const chosenChannel = interaction.options.getChannel('canal');
  const defaults = {
    ticket: 'ticket_panel',
    request: 'request_panel',
    set_request: 'welcome',
    set_remove: 'set_remove',
    welcome: 'welcome',
  };
  const target = chosenChannel ?? await getManagedTextChannel(interaction.guild, state, defaults[panel]);

  if (!target || target.type !== ChannelType.GuildText) {
    return replyError(interaction, 'Canal não encontrado. Execute `/setup` ou informe um canal de texto em `canal`.');
  }

  const me = interaction.guild.members.me;
  const channelPermissions = target.permissionsFor(me);
  if (!channelPermissions?.has([PermissionFlagsBits.ViewChannel, PermissionFlagsBits.SendMessages, PermissionFlagsBits.EmbedLinks])) {
    return replyError(interaction, `Não consigo enviar embeds no canal ${target}.`);
  }

  const displayName = state.displayName ?? interaction.guild.name;
  const message = panel === 'ticket'
    ? ticketPanel(displayName)
    : panel === 'request'
      ? requestPanel(displayName)
      : panel === 'set_request'
        ? setPanel('request', displayName)
        : panel === 'set_remove'
          ? setPanel('remove', displayName)
      : welcomePanel(displayName);

  await target.send(message);
  await interaction.reply({ content: `✅ Painel publicado em ${target}.`, ephemeral: true });
}

async function handleButton(interaction) {
  if (interaction.customId === 'set:request:start' || interaction.customId === 'set:remove:start') {
    const action = interaction.customId === 'set:request:start' ? 'request' : 'remove';
    return interaction.reply({
      content: action === 'request'
        ? 'Selecione a localidade para a qual deseja pedir set.'
        : 'Selecione a localidade da qual deseja remover o set.',
      ephemeral: true,
      components: [territorySelect(action)],
    });
  }

  if (interaction.customId === 'ticket:create') {
    await interaction.deferReply({ ephemeral: true });
    const channel = await createPrivateTicket(interaction, { kind: 'Ticket' });
    return interaction.editReply(`✅ Seu ticket foi criado: ${channel}`);
  }

  if (interaction.customId === 'request:create') {
    return interaction.showModal(requestModal());
  }

  if (interaction.customId === 'ticket:claim') {
    if (!(await isTeamMember(interaction))) {
      return replyError(interaction, 'Somente a equipe pode assumir este atendimento.');
    }

    await interaction.channel.send({
      embeds: [baseEmbed('🙋 Atendimento assumido', `${interaction.user} assumiu este atendimento.`)],
    });
    return interaction.reply({ content: '✅ Você assumiu este atendimento.', ephemeral: true });
  }

  if (interaction.customId === 'ticket:close') {
    const owner = ticketOwnerId(interaction.channel);
    if (owner !== interaction.user.id && !(await isTeamMember(interaction))) {
      return replyError(interaction, 'Apenas quem abriu o atendimento ou a equipe pode fechá-lo.');
    }

    return interaction.reply({
      content: 'Deseja realmente fechar este atendimento? Esta ação remove o canal.',
      ephemeral: true,
      components: [
        new ActionRowBuilder().addComponents(
          new ButtonBuilder()
            .setCustomId('ticket:confirm-close')
            .setLabel('Sim, fechar')
            .setStyle(ButtonStyle.Danger),
          new ButtonBuilder()
            .setCustomId('ticket:cancel-close')
            .setLabel('Cancelar')
            .setStyle(ButtonStyle.Secondary),
        ),
      ],
    });
  }

  if (interaction.customId === 'ticket:cancel-close') {
    return interaction.update({ content: 'Fechamento cancelado.', components: [] });
  }

  if (interaction.customId === 'ticket:confirm-close') {
    const owner = ticketOwnerId(interaction.channel);
    if (owner !== interaction.user.id && !(await isTeamMember(interaction))) {
      return replyError(interaction, 'Você não pode fechar este atendimento.');
    }

    await interaction.update({ content: '⏳ Fechando atendimento…', components: [] });
    await interaction.channel.delete(`${MANAGED_BY}: fechado por ${interaction.user.tag}`);
  }
}

async function handleTerritorySelect(interaction) {
  const action = interaction.customId === 'set:request:select' ? 'request' : 'remove';
  const territory = TERRITORY_DEFINITIONS.find((candidate) => candidate.key === interaction.values[0]);
  if (!territory) {
    return replyError(interaction, 'Localidade inválida. Selecione uma opção do painel.');
  }

  await interaction.deferReply({ ephemeral: true });
  const kind = action === 'request' ? 'Solicitação de Set' : 'Remoção de Set';
  const detailLabel = action === 'request' ? 'Set solicitado' : 'Set a remover';
  const channel = await createPrivateTicket(interaction, {
    kind,
    details: `**${detailLabel}:** ${territory.name}`,
  });

  await interaction.editReply(
    action === 'request'
      ? `✅ Sua solicitação para **${territory.name}** foi enviada em ${channel}.`
      : `✅ Seu pedido de remoção de **${territory.name}** foi enviado em ${channel}.`,
  );
}

async function handleModal(interaction) {
  if (interaction.customId !== 'request:modal') return;

  await interaction.deferReply({ ephemeral: true });
  const subject = interaction.fields.getTextInputValue('request_subject');
  const description = interaction.fields.getTextInputValue('request_description');
  const reference = interaction.fields.getTextInputValue('request_reference');
  const details = [
    `**Assunto:** ${subject}`,
    `**Descrição:** ${description}`,
    reference ? `**Referência:** ${reference}` : null,
  ].filter(Boolean).join('\n');

  const channel = await createPrivateTicket(interaction, {
    kind: 'Solicitação',
    details,
  });
  await interaction.editReply(`✅ Sua solicitação foi enviada em ${channel}.`);
}

client.once(Events.ClientReady, async (readyClient) => {
  console.log(`Conectado como ${readyClient.user.tag}`);

  try {
    if (process.env.GUILD_ID) {
      const guild = await readyClient.guilds.fetch(process.env.GUILD_ID);
      await guild.commands.set(COMMANDS);
      console.log(`Comandos registrados instantaneamente em ${guild.name}.`);
    } else {
      await readyClient.application.commands.set(COMMANDS);
      console.log('Comandos globais registrados. A propagação pode levar algum tempo.');
    }
  } catch (error) {
    console.error('Não foi possível registrar os comandos:', error);
  }
});

client.on(Events.InteractionCreate, async (interaction) => {
  try {
    if (interaction.isChatInputCommand()) {
      if (!interaction.inGuild()) return replyError(interaction, 'Este bot funciona somente em servidores.');
      if (interaction.commandName === 'setup') return handleSetup(interaction);
      if (interaction.commandName === 'gerenciar') return handleManage(interaction);
    }

    if (interaction.isButton()) return handleButton(interaction);
    if (interaction.isStringSelectMenu()) {
      if (interaction.customId === 'set:request:select' || interaction.customId === 'set:remove:select') {
        return handleTerritorySelect(interaction);
      }
    }
    if (interaction.isModalSubmit()) return handleModal(interaction);
  } catch (error) {
    console.error('Erro ao processar interação:', error);
    const message = error instanceof Error ? error.message : 'Ocorreu um erro inesperado.';
    await replyError(interaction, message);
  }
});

